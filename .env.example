# Needed for live runs only. `python cli.py --offline` needs neither value.
ANTHROPIC_API_KEY=your_key_here

# Required for live runs: the Claude model identifier to call. There is no
# built-in default; use an identifier your Anthropic account can access.
CLAUDE_MODEL=

# Optional: per-million-token prices (USD). If both are set and the SDK
# reports token usage, the report includes a labeled cost estimate.
# CLAUDE_INPUT_USD_PER_MTOK=
# CLAUDE_OUTPUT_USD_PER_MTOK=
